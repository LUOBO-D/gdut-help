{
  "name": "gduthelp",
  "private": true,
  "description": "广东工业大学校园生活助手：天气、课表、待办提醒、吃什么推荐",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "pnpm --filter @gduthelp/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @gduthelp/server exec prisma migrate dev"
  }
}
