# 复制为 .env 后按需修改。生成随机密钥：openssl rand -base64 48
NODE_ENV=development
PORT=3000

# docker compose 启动的数据库；没有 Docker 时可用 `pnpm --filter @gduthelp/server exec prisma dev` 起本地库，并把它输出的 TCP 地址填到这里
DATABASE_URL=postgresql://gduthelp:gduthelp@localhost:5432/gduthelp?schema=public

JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
AUTH_CODE_SECRET=change-me-to-another-random-string-32-chars

# 用逗号分隔，这些邮箱登录后自动成为管理员
ADMIN_EMAILS=

# 可选：校园邮箱白名单（逗号分隔，如 mail2.gdut.edu.cn,gdut.edu.cn）；留空表示不限制邮箱后缀
ALLOWED_EMAIL_DOMAINS=
# 可选：新用户注册邀请码（如 GDUT2026）；留空表示开放自由注册
INVITE_CODE=

# console：验证码打印在服务端日志里（仅开发环境可用）；smtp：真实发信
MAIL_DRIVER=console
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_SECURE=true，SMTP_PASS 填邮箱设置里生成的授权码
# Mailpit 示例：SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURE=false，SMTP_USER/PASS 留空
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 刷新令牌 Cookie 是否只在 HTTPS 下发送。不填时生产环境为 true，开发环境为 false
COOKIE_SECURE=

# 应用访问地址，用于提醒邮件里的链接（用 Tailscale 时填 https://<机器名>.<tailnet>.ts.net）
APP_URL=http://localhost:5173

# 和风天气（可选）：控制台 → 设置 中的 API Host，项目凭据里的 API KEY。不填时自动使用 Open-Meteo
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# 浏览器推送（Web Push）密钥：pnpm --filter @gduthelp/server exec web-push generate-vapid-keys
# 不填则不能开启浏览器推送，提醒仍会通过站内通知和邮件发出
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 提醒扫描间隔（秒），默认 15
# REMINDER_POLL_SECONDS=15
# 允许跨域访问 API 的来源，逗号分隔。用安卓 App 时填 https://localhost；只用网页时留空
CORS_ORIGINS=

# 自用阶段设为 true（提交商家直接上架）；公开发布后改为 false（需审核或多人确认）
MERCHANT_AUTO_APPROVE=true

# 可选大模型（DeepSeek / OpenAI 兼容接口）：用于润色「吃什么」推荐理由；留空则纯用规则模板，不发外部请求
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选：单容器生产部署时由后端直接托管前端构建产物（apps/web/dist）的目录路径
STATIC_DIR=
