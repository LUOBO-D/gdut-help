generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  normal
  banned
}

model User {
  id         String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  /// 公开发布后用于实名，自用阶段为空
  phone             String?    @unique
  /// 可选登录密码（scrypt 哈希）；未设置时仅用邮箱验证码登录
  passwordHash      String?    @map("password_hash")
  passwordUpdatedAt DateTime?  @map("password_updated_at") @db.Timestamptz
  nickname          String
  avatarUrl  String?    @map("avatar_url")
  role       UserRole   @default(user)
  /// 0 新用户 / 1 普通 / 2 可信（见 docs/03-backend.md 4.5）
  trustLevel Int        @default(0) @map("trust_level") @db.SmallInt
  status     UserStatus @default(normal)
  /// 所在校区 ID，取值见 packages/shared/src/gdut.ts
  campusId      String?    @map("campus_id")
  /// 提醒是否同时发邮件（安卓上浏览器推送不可靠，邮件是保底渠道）
  remindByEmail Boolean    @default(true) @map("remind_by_email")
  /// 是否开启每天饭点（11:30 / 17:20）自动推送餐食推荐
  remindMeal         Boolean    @default(false) @map("remind_meal")
  /// 课前提醒提前分钟数（0 关闭 / 10 / 15 / 20）
  classRemindMinutes Int        @default(0) @map("class_remind_minutes") @db.SmallInt
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens         RefreshToken[]
  courses               Course[]
  todos                 Todo[]
  reminders             Reminder[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  preference            UserPreference?
  submittedMerchants    Merchant[]
  merchantConfirmations MerchantConfirmation[]
  merchantEdits         MerchantEdit[]
  submittedDishes       Dish[]
  moodLogs              MoodLog[]
  mealFeedbacks         MealFeedback[]
  reviews               Review[]
  reviewLikes           ReviewLike[]
  mealNotifyLogs        MealNotifyLog[]
  classNotifyLogs       ClassNotifyLog[]
  timetableShares       TimetableShare[]
  exams                 Exam[]
  fitnessRecords        FitnessRecord[]
  courseGrades          CourseGrade[]
  creditPlan            UserCreditPlan?
  secondClassRecords    SecondClassRecord[]
  submittedSharedCourses SharedCourse[]
  courseReviews         CourseReview[]
  courseReviewLikes     CourseReviewLike[]
  cetRecords            CetRecord[]
  selectionReminders    CourseSelectionReminder[]

  @@map("users")
}

/// 邮箱验证码。只保存 HMAC 摘要，不保存明文。
model EmailCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  ip         String?
  attempts   Int       @default(0) @db.SmallInt
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("email_codes")
}

/// 刷新令牌。只保存 SHA-256 摘要；每次刷新都轮换，旧令牌被再次使用时吊销该用户全部令牌。
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// 学期。全校统一，由管理员维护；同一时间只有一个 isCurrent
model Semester {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  /// 第 1 周的周一
  startDate  DateTime @map("start_date") @db.Date
  totalWeeks Int      @map("total_weeks") @db.SmallInt
  isCurrent  Boolean  @default(false) @map("is_current")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  courses Course[]
  shares  TimetableShare[]
  exams   Exam[]

  @@map("semesters")
}

model Course {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  name       String
  teacher    String?
  location   String?
  color      String
  /// manual：自己添加；import：从教务系统导入。重新导入只会改动 import 的课程
  source     CourseSource @default(manual)
  /// 导入课程的匹配键（课程名 + 老师），重新导入时据此判断是同一门课
  importKey  String?  @map("import_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  slots    CourseSlot[]

  @@index([userId, semesterId])
  @@map("courses")
}

enum CourseSource {
  manual
  import
}

/// 一门课的一个上课时间段：星期几、第几节到第几节、哪些周
model CourseSlot {
  id          String  @id @default(uuid()) @db.Uuid
  courseId    String  @map("course_id") @db.Uuid
  weekday     Int     @db.SmallInt
  periodStart Int     @map("period_start") @db.SmallInt
  periodEnd   Int     @map("period_end") @db.SmallInt
  weeks       Int[]   @db.SmallInt
  /// 不同时间段可能在不同教室；为空时用课程的 location
  location    String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_slots")
}

enum TodoRepeat {
  none
  daily
  weekly
}

model Todo {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  title       String
  note        String?
  dueAt       DateTime?  @map("due_at") @db.Timestamptz
  /// 1 最高 … 4 最低
  priority    Int        @default(3) @db.SmallInt
  /// 重复周期：none 不重复 / daily 每天 / weekly 每周
  repeat      TodoRepeat @default(none)
  completedAt DateTime?  @map("completed_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, completedAt])
  @@map("todos")
}

enum ReminderStatus {
  pending
  sent
  cancelled
}

model Reminder {
  id            String         @id @default(uuid()) @db.Uuid
  todoId        String         @map("todo_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  /// 「截止前 N 分钟」类型的提醒；为空表示指定了具体时间
  offsetMinutes Int?           @map("offset_minutes")
  fireAt        DateTime       @map("fire_at") @db.Timestamptz
  status        ReminderStatus @default(pending)
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, fireAt])
  @@index([todoId])
  @@map("reminders")
}

/// 站内通知：所有提醒都会写一条，打开应用时可以看到
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// 浏览器推送订阅（Web Push）。推送服务返回 404/410 时自动删除
model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// 用户饮食偏好（口味、忌口、每餐预算）
model UserPreference {
  userId    String   @id @map("user_id") @db.Uuid
  tastes    String[] @default([])
  dislikes  String[] @default([])
  budgetMin Int?     @map("budget_min") @db.SmallInt
  budgetMax Int?     @map("budget_max") @db.SmallInt
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum MerchantCategory {
  canteen
  restaurant
  noodle
  fastfood
  drink
  snack
  dessert
  hotpot
}

enum MerchantStatus {
  pending
  approved
  rejected
  closed
}

enum MerchantConfirmKind {
  exists
  closed
}

enum MerchantEditStatus {
  pending
  applied
  rejected
}

enum DishStatus {
  visible
  hidden
}

enum MoodType {
  happy
  calm
  tired
  anxious
  down
  treat
}

enum MealType {
  lunch
  dinner
}

enum MealFeedbackAction {
  accepted
  skipped
  disliked
}

/// 商家（食堂档口、校外餐厅、奶茶店等），全部由用户提交
model Merchant {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  category     MerchantCategory
  campusId     String           @map("campus_id")
  locationText String           @map("location_text")
  /// 从教学区步行约需分钟数（自用阶段无需地图选点即可按距离打分）
  walkMinutes  Int?             @map("walk_minutes") @db.SmallInt
  lat          Float?
  lng          Float?
  /// 人均价格（元）
  priceAvg     Int              @map("price_avg") @db.SmallInt
  tags         String[]         @default([])
  /// 营业信息，如 { meals: ["lunch", "dinner"], text: "10:30-21:00" }
  openHours    Json?            @map("open_hours")
  submittedBy  String           @map("submitted_by") @db.Uuid
  confirmCount Int              @default(0) @map("confirm_count") @db.SmallInt
  status       MerchantStatus   @default(approved)
  ratingAvg    Float            @default(0) @map("rating_avg")
  ratingCount  Int              @default(0) @map("rating_count")
  bayesScore   Float            @default(0) @map("bayes_score")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  submitter     User                   @relation(fields: [submittedBy], references: [id], onDelete: Cascade)
  confirmations MerchantConfirmation[]
  edits         MerchantEdit[]
  dishes        Dish[]
  feedbacks     MealFeedback[]
  reviews       Review[]

  @@index([campusId, status])
  @@index([submittedBy])
  @@map("merchants")
}

/// 商家存在/已关店确认（数据表在 S3 建好，多人确认逻辑在公开版 P2 启用）
model MerchantConfirmation {
  id         String              @id @default(uuid()) @db.Uuid
  merchantId String              @map("merchant_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  kind       MerchantConfirmKind
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId, kind])
  @@map("merchant_confirmations")
}

/// 商家纠错记录（P2 公开版启用多人确认/审核流程）
model MerchantEdit {
  id           String             @id @default(uuid()) @db.Uuid
  merchantId   String             @map("merchant_id") @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  changes      Json
  confirmCount Int                @default(0) @map("confirm_count") @db.SmallInt
  status       MerchantEditStatus @default(pending)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@map("merchant_edits")
}

/// 商家招牌菜品（可选补充，有菜品时推荐理由会更具体）
model Dish {
  id          String     @id @default(uuid()) @db.Uuid
  merchantId  String     @map("merchant_id") @db.Uuid
  name        String
  price       Int?       @db.SmallInt
  tags        String[]   @default([])
  submittedBy String     @map("submitted_by") @db.Uuid
  status      DishStatus @default(visible)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  merchant  Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  submitter User     @relation(fields: [submittedBy], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@map("dishes")
}

/// 每日心情记录（每人每天一条，重复提交覆盖）
model MoodLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// 北京日期 'YYYY-MM-DD'
  date      String
  mood      MoodType
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("mood_logs")
}

/// 餐食推荐反馈（接受 / 换一个 / 不想吃），用于去重与偏好学习
model MealFeedback {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  merchantId String             @map("merchant_id") @db.Uuid
  meal       MealType
  action     MealFeedbackAction
  /// 北京日期 'YYYY-MM-DD'
  date       String
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([userId, date, meal])
  @@index([userId, merchantId])
  @@map("meal_feedback")
}

enum ReviewStatus {
  visible
  hidden
  pending
}

/// 商家评分与个人评价（每人每商家一条主评价，修改即覆盖并重算贝叶斯分）
model Review {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  merchantId   String       @map("merchant_id") @db.Uuid
  scoreTaste   Int          @map("score_taste") @db.SmallInt
  scoreValue   Int          @map("score_value") @db.SmallInt
  scoreEnv     Int          @map("score_env") @db.SmallInt
  scoreSpeed   Int          @map("score_speed") @db.SmallInt
  scoreOverall Int          @map("score_overall") @db.SmallInt
  content      String       @default("")
  images       String[]     @default([])
  likeCount    Int          @default(0) @map("like_count")
  status       ReviewStatus @default(visible)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  likes    ReviewLike[]

  @@unique([userId, merchantId])
  @@index([merchantId, status, createdAt])
  @@map("reviews")
}

model ReviewLike {
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("review_likes")
}

/// 饭点推送幂等记录：保证每人每天每餐最多推送一次
model MealNotifyLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  date       String
  meal       MealType
  merchantId String   @map("merchant_id") @db.Uuid
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, meal])
  @@map("meal_notify_logs")
}

/// 课前提醒幂等记录：保证每节具体上课只发一次服务端提醒
model ClassNotifyLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// 北京日期 'YYYY-MM-DD'
  date        String
  courseId    String   @map("course_id") @db.Uuid
  periodStart Int      @map("period_start") @db.SmallInt
  sentAt      DateTime @default(now()) @map("sent_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, courseId, periodStart])
  @@map("class_notify_logs")
}

/// 课表 6 位短码分享快照（7 天有效，不含分享者个人敏感信息）
model TimetableShare {
  code       String   @id
  createdBy  String   @map("created_by") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  courses    Json
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  creator  User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("timetable_shares")
}

/// 个人考试安排：支持从广工教务系统一键同步（按 importKey 幂等增量更新）或手动录入（如四六级/期中测验）
model Exam {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  semesterId String       @map("semester_id") @db.Uuid
  courseName String       @map("course_name")
  /// 北京日期 'YYYY-MM-DD'（文本存储，避免时区转换偏移）
  examDate   String       @map("exam_date")
  /// 开始时间 'HH:mm'
  startTime  String       @map("start_time")
  /// 结束时间 'HH:mm'
  endTime    String       @map("end_time")
  location   String?
  seatNo     String?      @map("seat_no")
  examType   String?      @map("exam_type")
  campus     String?
  note       String?
  source     CourseSource @default(manual)
  importKey  String?      @map("import_key")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([userId, semesterId])
  @@index([userId, examDate])
  @@map("exams")
}

enum FitnessGender {
  male
  female
}

/// 个人体测成绩档案（按用户+学年唯一，支持手动录入与多格式粘贴导入，自动按国家标准算分）
model FitnessRecord {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  /// 学年，例如 '2025-2026'
  academicYear       String        @map("academic_year")
  /// 年级：1 大一 / 2 大二 / 3 大三 / 4 大四
  gradeYear          Int           @map("grade_year") @db.SmallInt
  gender             FitnessGender
  heightCm           Float?        @map("height_cm")
  weightKg           Float?        @map("weight_kg")
  lungCapacityMl     Int?          @map("lung_capacity_ml")
  sprint50mSec       Float?        @map("sprint_50m_sec")
  sitAndReachCm      Float?        @map("sit_and_reach_cm")
  standingLongJumpCm Int?          @map("standing_long_jump_cm")
  strengthCount      Int?          @map("strength_count") @db.SmallInt
  enduranceSec       Int?          @map("endurance_sec") @db.SmallInt
  exempt             Boolean       @default(false)
  officialTotal      Float?        @map("official_total")
  testedAt           String?       @map("tested_at")
  note               String?
  source             CourseSource  @default(manual)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, academicYear])
  @@index([userId, gradeYear])
  @@map("fitness_records")
}

/// 个人课程成绩与绩点档案（支持教务系统自动同步与手动试算/补充）
model CourseGrade {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  /// 学期代码，例如 '202501'
  semesterCode String       @map("semester_code")
  /// 学期名称，例如 '2025-2026 秋季'
  semesterName String       @map("semester_name")
  courseCode   String?      @map("course_code")
  courseName   String       @map("course_name")
  credits      Float
  /// 原始成绩文本（如 '88'、'优秀'）
  scoreText    String       @map("score_text")
  scoreNum     Float?       @map("score_num")
  gradePoint   Float        @map("grade_point")
  courseType   String?      @map("course_type")
  examType     String?      @map("exam_type")
  source       CourseSource @default(manual)
  importKey    String?      @map("import_key")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semesterCode])
  @@index([userId, importKey])
  @@map("course_grades")
}

/// 个人学分毕业目标与第二课堂目标配置（含教务培养方案学分完成情况官方快照）
model UserCreditPlan {
  userId                    String    @id @map("user_id") @db.Uuid
  totalTarget               Float     @default(160) @map("total_target")
  generalRequiredTarget     Float     @default(42) @map("general_required_target")
  majorRequiredTarget       Float     @default(64) @map("major_required_target")
  majorElectiveTarget       Float     @default(22) @map("major_elective_target")
  generalElectiveTarget     Float     @default(10) @map("general_elective_target")
  practiceTarget            Float     @default(22) @map("practice_target")
  majorName                 String?   @map("major_name")
  /// 教务培养方案完成情况官方模块列表 JSON
  officialModules           Json?     @map("official_modules")
  officialSyncedAt          DateTime? @map("official_synced_at") @db.Timestamptz
  secondClassSemesterTarget Float     @default(12) @map("second_class_semester_target")
  secondClassYearTarget     Float     @default(24) @map("second_class_year_target")
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credit_plans")
}

enum SecondClassCategory {
  ideology
  volunteer
  innovation
  culture
  practice
  leadership
}

enum SecondClassStatus {
  approved
  pending
}

/// 个人第二课堂（素质拓展）活动时长记录：按学期与学年聚合统计
model SecondClassRecord {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  /// 学年，例如 '2026-2027'
  academicYear String              @map("academic_year")
  /// 学期代码，例如 '202601'
  semesterCode String              @map("semester_code")
  title        String
  category     SecondClassCategory
  /// 认定或待审时长（小时/学时）
  hours        Float
  /// 折算二课学分（可选，默认 0）
  credits      Float               @default(0)
  /// 活动日期 'YYYY-MM-DD'
  activityDate String              @map("activity_date")
  organizer    String?
  status       SecondClassStatus   @default(approved)
  source       CourseSource        @default(manual)
  importKey    String?             @map("import_key")
  note         String?
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, academicYear, semesterCode])
  @@index([userId, importKey])
  @@map("second_class_records")
}

enum SharedCourseCategory {
  general_elective
  general_required
  major_required
  major_elective
  pe
  other
}

enum CourseAttendanceLevel {
  none
  occasional
  strict
}

enum CourseExamFormat {
  open_book
  closed_book
  paper
  project
  mixed
}

/// 选课评价全校共享课程库（仅聚焦「公共选修课」与「体育选课」，按 课程名 + 任课老师 + 校区 唯一）
model SharedCourse {
  id             String               @id @default(uuid()) @db.Uuid
  courseCode     String?              @map("course_code")
  courseName     String               @map("course_name")
  teacherName    String               @map("teacher_name")
  campusId       String               @default("hemc") @map("campus_id")
  category       SharedCourseCategory @default(general_elective)
  subCategory    String?              @map("sub_category")
  department     String?
  credits        Float?
  submittedBy    String?              @map("submitted_by") @db.Uuid
  ratingOverall  Float                @default(0) @map("rating_overall")
  ratingGrading  Float                @default(0) @map("rating_grading")
  ratingWorkload Float                @default(0) @map("rating_workload")
  ratingQuality  Float                @default(0) @map("rating_quality")
  reviewCount    Int                  @default(0) @map("review_count")
  bayesScore     Float                @default(0) @map("bayes_score")
  topTags        String[]             @default([]) @map("top_tags")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  submitter User?          @relation(fields: [submittedBy], references: [id], onDelete: SetNull)
  reviews   CourseReview[]

  @@unique([courseName, teacherName, campusId])
  @@index([campusId, bayesScore])
  @@index([category, bayesScore])
  @@index([courseName])
  @@index([teacherName])
  @@map("shared_courses")
}

/// 选课评价明细（每人每门「课程+老师」一条评价，支持匿名展示与点赞「有用」）
model CourseReview {
  id            String                @id @default(uuid()) @db.Uuid
  courseId      String                @map("course_id") @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  scoreOverall  Int                   @map("score_overall") @db.SmallInt
  scoreGrading  Int                   @map("score_grading") @db.SmallInt
  scoreWorkload Int                   @map("score_workload") @db.SmallInt
  scoreQuality  Int                   @map("score_quality") @db.SmallInt
  attendance    CourseAttendanceLevel
  examFormat    CourseExamFormat      @map("exam_format")
  semesterTaken String?               @map("semester_taken")
  tags          String[]              @default([])
  content       String                @default("")
  anonymous     Boolean               @default(false)
  likeCount     Int                   @default(0) @map("like_count")
  status        ReviewStatus          @default(visible)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  course SharedCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes  CourseReviewLike[]

  @@unique([userId, courseId])
  @@index([courseId, status, likeCount])
  @@map("course_reviews")
}

model CourseReviewLike {
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  review CourseReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("course_review_likes")
}

enum CetLevel {
  cet4
  cet6
}

/// 全国大学英语四六级成绩记录（每位用户按 level + 考次唯一）
model CetRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  level       CetLevel
  examSession String   @map("exam_session")
  totalScore  Int      @map("total_score") @db.SmallInt
  listening   Int?     @db.SmallInt
  reading     Int?     @db.SmallInt
  writing     Int?     @db.SmallInt
  oralGrade   String?  @map("oral_grade")
  ticketNo    String?  @map("ticket_no")
  source      String   @default("manual")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level, examSession])
  @@index([userId, level])
  @@map("cet_records")
}

/// 选课时间提醒（正选/公选抢课/体育选课/补退选，支持提前多档本地通知与首页倒计时）
model CourseSelectionReminder {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  kind        String    @default("elective")
  startAt     DateTime  @map("start_at") @db.Timestamptz
  endAt       DateTime? @map("end_at") @db.Timestamptz
  enabled     Boolean   @default(true)
  leadMinutes Int[]     @default([1440, 30, 5]) @map("lead_minutes") @db.SmallInt
  note        String?
  source      String    @default("manual")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@map("course_selection_reminders")
}
