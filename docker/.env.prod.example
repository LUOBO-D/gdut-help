# 复制为 docker/.env.prod 后填写真实密钥与发信配置
# 生成强随机密钥：openssl rand -base64 48

POSTGRES_USER=gduthelp
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=gduthelp
APP_PORT=3000

NODE_ENV=production
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
AUTH_CODE_SECRET=change-me-to-another-random-string-at-least-32-chars

# 管理员邮箱（逗号分隔）
ADMIN_EMAILS=you@example.com
# 可选：校园邮箱域名白名单（如 mail2.gdut.edu.cn,gdut.edu.cn），留空不限制
ALLOWED_EMAIL_DOMAINS=
# 可选：新用户注册邀请码，留空开放注册
INVITE_CODE=

# 生产环境必须使用真实 SMTP（推荐 QQ 邮箱 / 163 邮箱授权码）
MAIL_DRIVER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@qq.com
SMTP_PASS=your-smtp-auth-code
MAIL_FROM=GDUT Help <you@qq.com>

# 通过 Tailscale Serve 或 HTTPS 反代访问时填最终访问地址
APP_URL=https://gdut-vps.your-tailnet.ts.net
COOKIE_SECURE=true

# 安卓 App 跨域来源（仅使用网页端可留空）
CORS_ORIGINS=https://localhost

# 可选：和风天气 / Web Push / DeepSeek 推荐语润色
QWEATHER_API_HOST=
QWEATHER_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 自用阶段设为 true（提交商家直接上架）；面向全校公开时改为 false
MERCHANT_AUTO_APPROVE=true

LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 安全防护与告警（推荐开启）
# 服务端强制最低原生外壳 versionCode（0=过渡期不拦截；设为 7 后拒绝旧版 Debug 安装包返回 426）
MIN_NATIVE_VERSION=0
# 高危安全事件（蜜罐诱捕/网段联封/反复隔离）实时告警邮箱（复用上方 SMTP）
SECURITY_ALERT_EMAIL=
# 可选：高危安全事件实时 Webhook（支持飞书 / 企业微信 / 钉钉 / Discord，必须 HTTPS）
SECURITY_ALERT_WEBHOOK_URL=
# 仅在接入 Cloudflare 代理且 UFW 限制 443 仅放行 Cloudflare IP 段时设为 true
TRUST_CF_HEADERS=false
# 可选：异地备份 rclone 目标（例如 r2:gduthelp-backups 或 oss:gduthelp-backups）
BACKUP_RCLONE_REMOTE=
